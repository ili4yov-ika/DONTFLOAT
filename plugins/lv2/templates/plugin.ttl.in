@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .

<@LV2_URI@>
    a lv2:Plugin ,
      lv2:AnalyserPlugin ;
    doap:name "@LV2_NAME@" ;
    doap:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    ui:ui <@LV2_UI_URI@> ;
    lv2:port [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 0 ;
        lv2:symbol "in_l" ;
        lv2:name "Input L"
    ] , [
        a lv2:AudioPort ,
          lv2:InputPort ;
        lv2:index 1 ;
        lv2:symbol "in_r" ;
        lv2:name "Input R"
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 2 ;
        lv2:symbol "out_l" ;
        lv2:name "Output L"
    ] , [
        a lv2:AudioPort ,
          lv2:OutputPort ;
        lv2:index 3 ;
        lv2:symbol "out_r" ;
        lv2:name "Output R"
    ] .

<@LV2_UI_URI@>
    a @LV2_UI_TYPE@ ;
    ui:binary <@LV2_UI_BINARY@@LV2_BINARY_EXT@> .
