@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ui: <http://lv2plug.in/ns/extensions/ui#> .

<https://github.com/ili4yov-ika/DONTFLOAT/plugins/track-tool>
    a lv2:Plugin ;
    lv2:binary <dontfloat_track_tool@LV2_BINARY_EXT@> ;
    rdfs:seeAlso <dontfloat_track_tool.ttl> .

<https://github.com/ili4yov-ika/DONTFLOAT/plugins/track-tool#ui>
    a ui:UI ;
    ui:binary <dontfloat_track_tool_ui@LV2_BINARY_EXT@> ;
    rdfs:seeAlso <dontfloat_track_tool.ttl> .
